# SQLite veritabanı dosyası (prisma/ klasörüne göre değil, proje köküne göre)
DATABASE_URL="file:./dev.db"

# Yayındaki Turso veritabanı (Vercel). Doluysa uygulama DATABASE_URL yerine buna bağlanır ve
# npm run db:deploy migration'ları buraya uygular. Yerelde boş bırakın.
# URL: turso db show <ad> --url · Token: turso db tokens create <ad>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Misafir oturum cookie'sini imzalamak için en az 32 bayt rastgele değer.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# NBA CDN oyuncu fotoğrafları (true/false). false ise baş harfli avatar gösterilir.
NEXT_PUBLIC_REMOTE_MEDIA=true

# Ters proxy arkasında çalışıyorsa true: rate limit için X-Forwarded-For güvenilir sayılır.
TRUST_PROXY=false

# Saatte istemci anahtarı başına yeni misafir sınırı. TRUST_PROXY=false iken tüm çerezsiz istemciler tek anahtarı paylaşır;
# yayında ters proxy arkasında TRUST_PROXY=true kullanın.
GUEST_LIMIT_PER_HOUR=10
